{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/main-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [".env.local", ".env"],
    "webpack": false,
    "tsConfigPath": "apps/main-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/main-api",
  "projects": {
    "main-api": {
      "type": "application",
      "root": "apps/main-api",
      "entryFile": "main",
      "sourceRoot": "apps/main-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/main-api/tsconfig.app.json"
      }
    },
    "writter": {
      "type": "application",
      "root": "apps/writter",
      "entryFile": "main",
      "sourceRoot": "apps/writter/src",
      "compilerOptions": {
        "tsConfigPath": "apps/writter/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "aws": {
      "type": "library",
      "root": "libs/aws",
      "entryFile": "index",
      "sourceRoot": "libs/aws/src",
      "compilerOptions": {
        "tsConfigPath": "libs/aws/tsconfig.lib.json"
      }
    },
    "mongoose": {
      "type": "library",
      "root": "libs/mongoose",
      "entryFile": "index",
      "sourceRoot": "libs/mongoose/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mongoose/tsconfig.lib.json"
      }
    },
    "reader": {
      "type": "application",
      "root": "apps/reader",
      "entryFile": "main",
      "sourceRoot": "apps/reader/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reader/tsconfig.app.json"
      }
    },
    "typeorm": {
      "type": "library",
      "root": "libs/typeorm",
      "entryFile": "index",
      "sourceRoot": "libs/typeorm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/typeorm/tsconfig.lib.json"
      }
    },
    "kafka": {
      "type": "library",
      "root": "libs/kafka",
      "entryFile": "index",
      "sourceRoot": "libs/kafka/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka/tsconfig.lib.json"
      }
    }
  }
}
