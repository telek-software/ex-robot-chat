  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^~[aws](|/.*)$": "<rootDir>/libs/aws/src/$1",
      "^~[mongoose](|/.*)$": "<rootDir>/libs/mongoose/src/$1",
      "^~[shared](|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^~[typeorm](|/.*)$": "<rootDir>/libs/typeorm/src/$1",
      "^~[kafka](|/.*)$": "<rootDir>/libs/kafka/src/$1"
    }
